# 408Web FastAPI 本地环境配置
DATABASE_URL=sqlite+aiosqlite:///./data/web408.db

# 必须替换为随机生成且至少 32 字符的密钥，不要提交真实值
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256

# AI 的 Go Key、模型、输入模式与启用状态在个人中心设置，不写环境文件。
# AI 在 FastAPI 进程内运行，不新增监听端口，也不启动独立 Node 服务。
# 系统凭据自动保存于系统用户私有目录，Windows 为 %LOCALAPPDATA%/408web/ai/。
# master.key 仅后端使用，首次保存新 Go Key 时生成，必须独立备份且不提交 Git。
# 运行超时与容量使用服务端固定默认值，不通过环境变量覆盖。
# 历史遗留的 service.token 已无代码读取，保留不删以便回滚，可自行决定是否清理。

UPLOAD_DIR=uploads/images
MAX_FILE_SIZE=10485760
SERVER_HOST=0.0.0.0
SERVER_PORT=7785
API_PREFIX=/api
CORS_ORIGINS=http://localhost:7784
